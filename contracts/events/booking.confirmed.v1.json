{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seatsac.dev/events/booking.confirmed.v1.json",
  "title": "BookingConfirmed",
  "description": "SQS cinema-staging-notification-events. 발행자 booking만 (ADR-30). 확정 트랜잭션의 아웃박스 행을 릴레이가 발송(API 명세서 v1.1 9-2, 10/21). 메시지 속성 type·traceId. 개인정보(이메일·이름) 금지.",
  "type": "object",
  "required": [
    "eventId",
    "type",
    "version",
    "occurredAt",
    "producer",
    "traceId",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "아웃박스 행 생성 때 정한 UUID. 재전송해도 같은 값(소비자 중복 제거)"
    },
    "type": {
      "type": "string",
      "const": "booking.confirmed"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "const": "booking"
    },
    "traceId": {
      "type": "string",
      "description": "Gateway X-Trace-Id (소문자 16진수 32자리)",
      "pattern": "^[0-9a-f]{32}$"
    },
    "payload": {
      "type": "object",
      "required": [
        "bookingId",
        "userId",
        "screeningId",
        "movieTitle",
        "theaterName",
        "auditoriumName",
        "startsAt",
        "seatLabels",
        "seatCount",
        "amount",
        "confirmedAt"
      ],
      "properties": {
        "bookingId": {
          "type": "integer"
        },
        "userId": {
          "type": "string",
          "format": "uuid",
          "description": "Cognito sub"
        },
        "movieTitle": {
          "type": "string"
        },
        "theaterName": {
          "type": "string"
        },
        "auditoriumName": {
          "type": "string"
        },
        "startsAt": {
          "type": "string",
          "format": "date-time"
        },
        "seatLabels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "amount": {
          "type": "integer"
        },
        "screeningId": {
          "type": "integer"
        },
        "seatCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "confirmedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
