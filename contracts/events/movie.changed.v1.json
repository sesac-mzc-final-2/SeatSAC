{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seatsac.dev/events/movie.changed.v1.json",
  "title": "MovieChanged",
  "description": "SNS cinema-staging-catalog-events → SQS cinema-staging-ai-catalog-events(ai_db 복제본, (여유 시) booking-catalog-events). raw message delivery, 메시지 속성 type·traceId. 발행자 catalog만 — 변경과 같은 트랜잭션의 outbox_message(aggregate_id = 원본 ID, aggregate_key = version, 변경 1번 = 새 행 1개) → 릴레이(1초, APP_OUTBOX_RELAY_ENABLED). 표준 큐라 순서가 바뀌거나 두 번 올 수 있다 — 받는 쪽은 processed_message(eventId)로 한 번만, 복제본은 version이 지금 값보다 클 때만 덮어쓴다(같거나 작으면 무시). 사이트에서 누구나 볼 수 있는 공개 필드만 — 포스터(롯데 이미지)·시드 원본·좌석 배치는 넣지 않는다(API 명세서 v1.5 26장, ADR-117·120). 영화가 생기거나 바뀌거나(TMDB 메타 보충 포함) 없어질 때. 영화 공개 필드 전체를 매번 보낸다. posterUrl은 넣지 않는다. 삭제(deleted=true)를 반영한 뒤에도 그 ID의 마지막 version을 보존하고(행 숨김·삭제 기록 등 방식은 구현이 정한다), 그 값 이하의 메시지는 무시한다 — 삭제 v3이 upsert v2보다 먼저 와도 삭제된 원본이 되살아나지 않게. 같은 ID가 다시 생기면 catalog가 더 큰 version으로 보낸다.",
  "type": "object",
  "required": [
    "eventId",
    "type",
    "version",
    "occurredAt",
    "producer",
    "traceId",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "아웃박스 행마다 새 UUID. 재전송해도 같은 값(소비자 inbox processed_message가 중복 제거). 같은 명령을 다시 보낼 때(재시도)는 새 행·새 eventId"
    },
    "type": {
      "type": "string",
      "const": "movie.changed"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "const": "catalog"
    },
    "traceId": {
      "type": "string",
      "description": "Gateway X-Trace-Id (소문자 16진수 32자리). 요청 없는 작업(스윕·릴레이)은 새로 생성",
      "pattern": "^[0-9a-f]{32}$"
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "catalog 이벤트는 saga가 아니라 null(또는 없음)"
    },
    "payload": {
      "type": "object",
      "required": [
        "movieId",
        "version",
        "deleted",
        "changedAt"
      ],
      "properties": {
        "movieId": {
          "type": "integer"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "이 원본 행의 버전. catalog가 바꿀 때마다 1씩 올린다(삭제도 한 번의 변경). 받는 쪽은 이 값이 클 때만 덮어쓴다"
        },
        "deleted": {
          "type": "boolean",
          "description": "true면 원본이 없어졌거나 더 보여 주지 않는다 → 복제본에서 지우거나 숨기되 마지막 version은 남긴다. 이때 ID·version·changedAt 외 필드는 없거나 null일 수 있다"
        },
        "changedAt": {
          "type": "string",
          "format": "date-time"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "titleEn": {
          "type": [
            "string",
            "null"
          ]
        },
        "viewGrade": {
          "type": [
            "string",
            "null"
          ],
          "x-extensible-enum": [
            "ALL",
            "12",
            "15",
            "19"
          ],
          "description": "catalog.openapi.yaml ViewGrade"
        },
        "status": {
          "type": [
            "string",
            "null"
          ],
          "x-extensible-enum": [
            "NOW_SHOWING",
            "COMING_SOON"
          ],
          "description": "catalog.openapi.yaml MovieStatus"
        },
        "slotMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "description": "시작~종료 간격 최빈값"
        },
        "runtimeMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "description": "원 러닝타임(TMDB)"
        },
        "releaseDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "director": {
          "type": [
            "string",
            "null"
          ]
        },
        "cast": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "genres": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "synopsis": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "description": "deleted=false면 공개 필드 전체가 반드시 있다(값이 없는 필드는 null). deleted=true면 movieId·version·deleted·changedAt만 있어도 된다",
      "if": {
        "properties": {
          "deleted": {
            "const": false
          }
        },
        "required": [
          "deleted"
        ]
      },
      "then": {
        "required": [
          "title",
          "titleEn",
          "viewGrade",
          "status",
          "slotMinutes",
          "runtimeMinutes",
          "releaseDate",
          "director",
          "cast",
          "genres",
          "synopsis"
        ]
      }
    }
  }
}
