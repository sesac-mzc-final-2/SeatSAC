{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seatsac.dev/events/payment.approved.v1.json",
  "title": "PaymentApproved",
  "description": "SQS cinema-staging-booking-replies. payment → booking(체크아웃 saga). 메시지 속성 type·traceId·correlationId. booking은 processed_message(eventId)로 한 번만, checkout_saga 상태를 조건으로 건 UPDATE로 반영한다(늦은 결과는 0행 → 무시). 결제 승인 — 명령 처리뿐 아니라 포트원 웹훅·payment 스윕이 saga 결제를 APPROVED로 닫을 때도 낸다(D7, saga_payment 표로 판별). booking은 예매가 PENDING이고 선점 안이면 확정, saga가 이미 EXPIRED면 확정하지 않고 refundNotice를 REFUND_IN_PROGRESS로 바꾸며 payment.release-requested를 한 번 더 보낸다.",
  "type": "object",
  "required": [
    "eventId",
    "type",
    "version",
    "occurredAt",
    "producer",
    "traceId",
    "correlationId",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "아웃박스 행마다 새 UUID. 재전송해도 같은 값(소비자 inbox processed_message가 중복 제거). 재확인 명령은 시도마다 새 행·새 eventId"
    },
    "type": {
      "type": "string",
      "const": "payment.approved"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "const": "payment"
    },
    "traceId": {
      "type": "string",
      "description": "Gateway X-Trace-Id (소문자 16진수 32자리). 요청 없는 작업(스윕)은 새로 생성",
      "pattern": "^[0-9a-f]{32}$"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid",
      "description": "체크아웃 saga ID(checkoutId). SQS 메시지 속성 correlationId와 같은 값"
    },
    "payload": {
      "type": "object",
      "required": [
        "checkoutId",
        "paymentId",
        "bookingId",
        "amount",
        "approvedAt"
      ],
      "properties": {
        "checkoutId": {
          "type": "string",
          "format": "uuid",
          "description": "= correlationId"
        },
        "paymentId": {
          "type": "string",
          "format": "uuid",
          "description": "booking 발급. payment 행의 PK"
        },
        "bookingId": {
          "type": "integer"
        },
        "amount": {
          "type": "integer",
          "minimum": 1
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        },
        "pgTransactionId": {
          "type": [
            "string",
            "null"
          ],
          "description": "PORTONE 거래 ID. MOCK은 null"
        }
      }
    }
  }
}
