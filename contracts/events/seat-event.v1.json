{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seatsac.dev/events/seat-event.v1.json",
  "title": "SeatEvent",
  "description": "Valkey Pub/Sub seat-events:{screeningId} → SSE. RDS 커밋 후 발행. 필드 추가만 허용.",
  "type": "object",
  "required": [
    "seq",
    "type",
    "screeningId",
    "seatIds",
    "occurredAt",
    "traceId"
  ],
  "properties": {
    "seq": {
      "type": "integer",
      "description": "회차별 단조 증가 (INCR seat-seq:{screeningId}). 화면은 seq == lastSeq + 1일 때만 적용, 빈틈이면 BKG-01 재조회"
    },
    "type": {
      "type": "string",
      "enum": [
        "HELD",
        "RELEASED",
        "CONFIRMED",
        "EXPIRED"
      ]
    },
    "screeningId": {
      "type": "integer"
    },
    "seatIds": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "traceId": {
      "type": "string",
      "description": "요청의 X-Trace-Id(소문자 16진수 32자리). 만료 스캔처럼 요청이 없으면 새로 생성",
      "pattern": "^[0-9a-f]{32}$"
    }
  }
}
