<?xml version="1.0" encoding="UTF-8"?>
<!-- 서비스의 logback-spring.xml 에서 include 한다. local 프로필은 사람이 읽는 형식, 그 밖은 JSON 한 줄 -->
<included>
  <springProperty scope="context" name="service" source="spring.application.name" defaultValue="unknown"/>

  <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <timeZone>Asia/Seoul</timeZone>
      <fieldNames>
        <timestamp>timestamp</timestamp>
        <message>message</message>
        <logger>logger</logger>
        <thread>[ignore]</thread>
        <version>[ignore]</version>
        <levelValue>[ignore]</levelValue>
      </fieldNames>
      <customFields>{"service":"${service}"}</customFields>
      <!-- 허용 목록이다. 여기 없는 MDC 키는 로그에 나오지 않는다 (TraceKeys와 함께 고친다) -->
      <includeMdcKeyName>traceId</includeMdcKeyName>
      <includeMdcKeyName>userId</includeMdcKeyName>
      <includeMdcKeyName>job</includeMdcKeyName>
      <includeMdcKeyName>errorCode</includeMdcKeyName>
      <includeMdcKeyName>bookingId</includeMdcKeyName>
      <includeMdcKeyName>screeningId</includeMdcKeyName>
      <includeMdcKeyName>paymentId</includeMdcKeyName>
    </encoder>
  </appender>

  <appender name="PLAIN" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level [%X{traceId}]%X{job:- }%X{bookingId:- }%X{errorCode:- } %logger{24} - %msg%n</pattern>
    </encoder>
  </appender>

  <springProfile name="local">
    <root level="INFO"><appender-ref ref="PLAIN"/></root>
  </springProfile>
  <springProfile name="!local">
    <root level="INFO"><appender-ref ref="JSON"/></root>
  </springProfile>
</included>
