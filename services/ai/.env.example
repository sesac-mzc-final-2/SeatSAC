# 로컬 개발용. 이 파일을 .env 로 복사해서 쓴다. .env 는 커밋 금지.
APP_ENV=local

# 개발 전용 Claude API 키 (staging 키와 다른 키, 월 한도 $20 안에서). 값은 여기 적지 말고 .env 에만.
ANTHROPIC_API_KEY=

# 로컬 Compose의 ai Valkey (valkey/valkey-bundle, 호스트 포트 6380)
AI_VALKEY_HOST=localhost
APP_AI_VALKEY_PORT=6380
APP_AI_VALKEY_TLS=false

# 스냅샷 적재용 공개 API (로컬 gateway)
PUBLIC_API_BASE_URL=http://localhost:8080/api
